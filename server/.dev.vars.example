# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Comma-separated Google emails that receive the admin role on sign-in
ADMIN_EMAILS=
# Optional: restrict CORS to your deployed origin (defaults to request origin)
APP_ORIGIN=
