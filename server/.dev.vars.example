TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123
# Optional PayPal (Pro upgrades are disabled with a 503 when these are absent)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Comma-separated Google emails that receive the admin role on sign-in
ADMIN_EMAILS=
# Licensing: the public key is safe to bake; the private key stays offline.
LICENSE_PUBLIC_KEY={"crv":"Ed25519","kty":"OKP","x":"6-hrZAstyAp9_-Dw2TonOYIVUQeQmDJIvLiylVHq-6g"}
LICENSE_PRODUCT=carshare
# Set to 1 only for local development to bypass the admin write gate
LICENSE_DISABLED=
# Optional: hosted issuance server (license/ Worker). Empty = offline signed keys.
LICENSE_SERVER_URL=
# Optional: restrict CORS to your deployed origin (defaults to request origin)
APP_ORIGIN=
